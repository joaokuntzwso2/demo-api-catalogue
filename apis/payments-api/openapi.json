{
  "openapi": "3.0.3",
  "info": {
    "title": "Payments API",
    "version": "1.0.0",
    "description": "Iniciação e consulta de pagamentos internos e instantâneos."
  },
  "servers": [
    {
      "url": "http://localhost:5102"
    }
  ],
  "paths": {
    "/payments/v1/health": {
      "get": {
        "summary": "Health endpoint",
        "responses": {
          "200": {
            "description": "Health response"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/payments/v1/__admin/health-mode": {
      "post": {
        "summary": "Demo-only health simulation endpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "healthy",
                      "degraded",
                      "wrongPayload",
                      "down"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mode updated"
          }
        }
      }
    },
    "/payments/v1/payments/{paymentId}": {
      "get": {
        "summary": "Consultar pagamento",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/payments/v1/payments": {
      "post": {
        "summary": "Criar solicitação de pagamento",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  }
}
