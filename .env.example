# Local demo
INTEGRATOR_BASE_URL=http://localhost:6200
CATALOGUE_UI_URL=http://localhost:5173
HEALTH_WORKER_INTERVAL_MS=10000
BOOTSTRAP_REGISTRY=true

# WSO2 API Manager / APICTL integration
# Configure these when you want the pipeline to deploy into a real WSO2 API Manager 4.7 environment.
APIM_ENV=local-apim
APIM_GATEWAY_ENV=Default
APIM_HOST=https://localhost:9443
APIM_USERNAME=admin
APIM_PASSWORD=admin
APIM_SKIP_TLS=true

# Datadog demo integration. Leave empty to disable.
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
