<?xml version="1.0" encoding="UTF-8"?>
<api context="/catalogue-status/v1" name="CatalogueStatusAPI" xmlns="http://ws.apache.org/ns/synapse">

    <resource methods="GET" uri-template="/apis">
        <inSequence>
            <call>
                <endpoint>
                    <http method="GET" uri-template="http://health-status-cache:6300/cache/results"/>
                </endpoint>
            </call>
            <respond/>
        </inSequence>
        <faultSequence>
            <property name="HTTP_SC" value="500" scope="axis2" type="STRING"/>
            <payloadFactory media-type="json">
                <format>{
                  "error": "Catalogue Status API failed",
                  "message": "$1"
                }</format>
                <args>
                    <arg evaluator="xml" expression="$ctx:ERROR_MESSAGE"/>
                </args>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>

    <resource methods="GET" uri-template="/summary">
        <inSequence>
            <call>
                <endpoint>
                    <http method="GET" uri-template="http://health-status-cache:6300/cache/summary"/>
                </endpoint>
            </call>
            <respond/>
        </inSequence>
        <faultSequence>
            <property name="HTTP_SC" value="500" scope="axis2" type="STRING"/>
            <payloadFactory media-type="json">
                <format>{
                  "error": "Catalogue Status API summary failed",
                  "message": "$1"
                }</format>
                <args>
                    <arg evaluator="xml" expression="$ctx:ERROR_MESSAGE"/>
                </args>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>

</api>
